# Copy to .env and edit. docker compose reads this automatically.

# Org token. Needs read access to any gated repos your fleet uses.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where the cache lives on the NAS, and where hf_xet keeps its scratch chunks.
XHC_CACHE_PATH=/mnt/nvme/hf-cache
XHC_XET_PATH=/var/lib/muninn/xet

# Leave headroom below the raw array size; this is the number eviction targets.
XHC_CACHE_MAX_SIZE=70T

# How to handle a request for a file not yet cached.
#   stream   - default. N concurrent cold clients share ONE WAN fetch and all
#              receive bytes at ingest speed. Needs sequential writes (the
#              image sets HF_XET_RECONSTRUCT_WRITE_SEQUENTIALLY=1).
#   redirect - 302 to HF. Coalesces the ingest but NOT the clients: each pulls
#              from the WAN itself, and each needs its own Hub token.
#   wait     - block until ingest completes. Always correct, slowest.
XHC_MISS_POLICY=stream

# Seconds to remember that a file 404s upstream. Clients probe for optional
# files (processor_config.json, chat_template.jinja, ...) on every model load;
# without this each probe is a fresh WAN round-trip, per node. 0 disables.
XHC_NEGATIVE_TTL=60

# What to do with cached repos whose upstream has been deleted or gated.
#   retain - never evict them; the copy here is the only copy (default)
#   evict  - treat them as ordinary LRU candidates
XHC_ORPHAN_POLICY=retain
# How often to check cached repos against upstream. 0 disables detection.
XHC_ORPHAN_CHECK_INTERVAL=21600

# Rebuild repo listings from the cached snapshot when upstream 404s, so a repo
# deleted from the Hub stays enumerable (snapshot_download / hf download).
# Responses are tagged x-xhc-synthesized. 0 disables.
XHC_SYNTHESIZE_REPO_INFO=1

# Seconds a ref->commit mapping is trusted before revalidating upstream. This is
# what stops a moved `main` being served forever. 0 disables revalidation, which
# is what a pure archive wants.
XHC_REF_TTL=300

# What this cache is allowed to fetch. Policy gates INGEST, not serving, so
# tightening it cannot break a fleet mid-rollout. Set XHC_POLICY_SCOPE=all to
# enforce on cache hits too. Deny always wins over allow.
XHC_INGEST_POLICY=open
# XHC_ALLOW_REPOS=models/meta-llama/*,datasets/*
# XHC_DENY_REPOS=models/some-org/*
XHC_POLICY_SCOPE=ingest
# Refuse to ingest a single file larger than this (checked before bytes move).
# XHC_MAX_FILE_BYTES=200G

# Set to require a bearer token on /_cache/* management endpoints.
XHC_MANAGE_TOKEN=

XHC_MEM_LIMIT=16G
