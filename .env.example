# Copy to .env and edit. `docker compose` reads it automatically.
#
# Everything here has a working default in docker-compose.yml, so the only
# line you MUST set is HF_TOKEN, and only if you pull gated or private repos.
# The rest is for sizing this to your machine.

# --- the one that matters -------------------------------------------------

# Hugging Face token. Needs read access to any gated repos you use. One token
# here means client nodes need none of their own.
HF_TOKEN=

# Pin a release rather than tracking `latest` once you are past trying it out.
# Read the current version off the releases page rather than trusting this line.
MUNINN_VERSION=latest

# --- where things live ----------------------------------------------------
# Defaults are ./data/* so this runs unedited. Point them at real storage
# before you rely on it -- a bind mount under the repo is not a cache.

XHC_CACHE_PATH=./data/cache
XHC_XET_PATH=./data/xet
XHC_DOCKER_PATH=./data/docker

# --- sizing ---------------------------------------------------------------
# Both are budgets the cache evicts against, NOT filesystem sizes. Leave
# headroom: the high-water mark is a fraction of these, not of your disk.

XHC_CACHE_MAX_SIZE=100G
XHC_DOCKER_MAX_SIZE=50G
XHC_MEM_LIMIT=2G

# hf_xet scratch. Raise on a fast disk with room; it is working space, not
# durable storage.
HF_XET_CACHE_BYTES=10737418240

# Parallel range requests per ingest. The main throughput dial. Higher wants
# more RAM and a link that can use it -- measure rather than assume.
HF_XET_RANGE_GETS=16

# --- behaviour ------------------------------------------------------------

# What happens on a request for a file not yet cached.
#   stream    default. N concurrent cold clients share ONE upstream fetch and
#             all receive bytes at ingest speed.
#   redirect  302 upstream. Coalesces the ingest but not the clients; each
#             pulls from the WAN itself and needs its own token.
#   wait      block until ingest finishes. Always correct, slowest.
XHC_MISS_POLICY=stream

# A repo deleted or gated upstream exists ONLY here, so evicting it cannot be
# undone.  retain = never evict them.  evict = ordinary LRU candidates.
XHC_ORPHAN_POLICY=retain

# Set to require `Authorization: Bearer ...` on the /_cache management API.
# Leave empty and the management API is open to anything that can reach it.
XHC_MANAGE_TOKEN=

# --- Docker / OCI ---------------------------------------------------------

# Serve /v2/* at all.
XHC_DOCKER_ENABLED=1

# Policy defaults to `open`: anyone who can reach the port can pull from ANY
# registry onto your disk. Naming the registries you actually use is the
# cheapest hardening and does not require switching to allowlist mode.
#   XHC_ALLOW_REGISTRIES=docker.io,ghcr.io
XHC_ALLOW_REGISTRIES=

# Pull from a PRIVATE registry as the cache itself: `docker login` on this
# host, uncomment the config.json mount in docker-compose.yml, and set:
#   XHC_REGISTRY_AUTH_FILE=/auth/config.json
XHC_REGISTRY_AUTH_FILE=

# Client-facing auth on /v2/*. `basic` also needs XHC_DOCKER_HTPASSWD, and
# refuses to start if that file is missing or unreadable. It is a GATE, not
# per-client isolation: everyone who authenticates sees everything cached.
#   htpasswd -B -c ./htpasswd someuser
XHC_DOCKER_AUTH=none
XHC_DOCKER_HTPASSWD=

# --- push-through (off) ---------------------------------------------------
# With this on and no client auth, ANYONE WHO CAN REACH THE CACHE CAN PUSH to
# any registry it holds credentials for, as the cache, with no attribution.
# It warns at boot; it does not refuse. Decide deliberately.
XHC_DOCKER_PUSH=0

#   proxy          upstream confirmed BEFORE the client's 201
#   store-forward  201 first, forward behind -- faster, and it tells the client
#                  the push succeeded before the registry has it
XHC_DOCKER_PUSH_MODE=proxy

# Keep the pushed image locally. With store-forward and this at 0, the store
# is ephemeral: held until the forward confirms, then dropped.
XHC_DOCKER_CACHE_ON_PUSH=1

# Some registries sit behind a proxy that rejects large request bodies, and a
# plain `docker push` sends one monolithic PUT. Give per-registry chunk sizes
# in regctl's format and Muninn re-chunks on the way out:
#   {"hosts": {"registry.example.com": {"blobChunk": 16777216,
#                                       "blobMax":   16777216}}}
# Only blobChunk/blobMax are read -- credentials in that file are IGNORED, so
# use a limits-only file rather than mounting a real regctl config.
# Leave unset and Muninn discovers a working size from a 413 and logs it.
XHC_DOCKER_PUSH_LIMITS=
XHC_DOCKER_BLOB_CHUNK=
